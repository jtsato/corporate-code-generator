{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corporate-code-generator/schemas/model.schema.json",
  "title": "Corporate Code Generator Application Model",
  "description": "Declarative technology-agnostic application model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "application",
    "entities"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "application": {
      "$ref": "#/$defs/application"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "attributes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "uniqueGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uniqueGroup"
          }
        },
        "audited": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "uniqueGroup": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/primitiveType"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "identifier": {
          "type": "boolean",
          "default": false
        },
        "unique": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "primitiveType": {
      "type": "string",
      "enum": [
        "string",
        "boolean",
        "int32",
        "int64",
        "decimal",
        "uuid",
        "date",
        "datetime"
      ]
    }
  }
}
