{
  "name": "corporate-code-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Model-driven application scaffolding generator for corporate Golden Paths.",
  "keywords": [
    "code-generation",
    "scaffolding",
    "golden-path",
    "model-driven",
    "platform-engineering"
  ],
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --pretty",
    "test": "vitest run --exclude tests/smoke/maven-compile.smoke.test.ts --exclude tests/smoke/java-multimodule-maven-compile.smoke.test.ts --exclude tests/smoke/java-multimodule-archunit.smoke.test.ts --exclude tests/smoke/java-multimodule-validation.smoke.test.ts --exclude tests/smoke/java-multimodule-paging.smoke.test.ts --exclude tests/smoke/java-multimodule-jpa-paging.smoke.test.ts --exclude tests/smoke/java-multimodule-error-handling.smoke.test.ts --exclude tests/smoke/java-multimodule-cors.smoke.test.ts --exclude tests/smoke/java-multimodule-openapi.smoke.test.ts --exclude tests/smoke/java-multimodule-spring-context.smoke.test.ts --exclude tests/smoke/java-multimodule-http-runtime.smoke.test.ts --exclude tests/smoke/java-multimodule-http-persistence-read.smoke.test.ts",
    "smoke": "npm run build && vitest run tests/smoke/cli.smoke.test.ts",
    "smoke:maven": "npm run build && vitest run tests/smoke/maven-compile.smoke.test.ts",
    "smoke:maven:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-maven-compile.smoke.test.ts",
    "smoke:archunit:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-archunit.smoke.test.ts",
    "smoke:validation:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-validation.smoke.test.ts",
    "smoke:paging:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-paging.smoke.test.ts",
    "smoke:jpa-paging:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-jpa-paging.smoke.test.ts",
    "smoke:error-handling:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-error-handling.smoke.test.ts",
    "smoke:cors:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-cors.smoke.test.ts",
    "smoke:openapi:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-openapi.smoke.test.ts",
    "smoke:spring-context:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-spring-context.smoke.test.ts",
    "smoke:http:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-http-runtime.smoke.test.ts",
    "smoke:http-persistence-read:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule-http-persistence-read.smoke.test.ts",
    "smoke:java-multimodule": "npm run build && vitest run tests/smoke/java-multimodule.smoke.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/smoke/maven-compile.smoke.test.ts --exclude tests/smoke/java-multimodule-maven-compile.smoke.test.ts --exclude tests/smoke/java-multimodule-archunit.smoke.test.ts --exclude tests/smoke/java-multimodule-validation.smoke.test.ts --exclude tests/smoke/java-multimodule-paging.smoke.test.ts --exclude tests/smoke/java-multimodule-jpa-paging.smoke.test.ts --exclude tests/smoke/java-multimodule-error-handling.smoke.test.ts --exclude tests/smoke/java-multimodule-cors.smoke.test.ts --exclude tests/smoke/java-multimodule-openapi.smoke.test.ts --exclude tests/smoke/java-multimodule-spring-context.smoke.test.ts --exclude tests/smoke/java-multimodule-http-runtime.smoke.test.ts --exclude tests/smoke/java-multimodule-http-persistence-read.smoke.test.ts",
    "mutation": "stryker run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/yaml": "^1.9.6",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
