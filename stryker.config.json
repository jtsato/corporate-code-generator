{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "dir": "packages",
    "related": true
  },
  "mutate": [
    "packages/*/src/**/*.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "ignorePatterns": [
    "coverage",
    "dist",
    "generated"
  ]
}
