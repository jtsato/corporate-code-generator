{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
{%- for package in packages %}
      "@{{ applicationName }}/{{ package.name }}/*": ["packages/{{ package.name }}/src/*"]{% if not loop.last %},{% endif %}
{%- endfor %}
    }
  }
}
