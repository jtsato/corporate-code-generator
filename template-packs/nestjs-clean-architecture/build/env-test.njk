# Deterministic test configuration. Committed, so it must never hold a secret.
#
# CORS is disabled: the generated end-to-end suite drives the application in
# process, where no browser origin exists, and leaving it off keeps a CORS change
# from silently altering test behaviour.
NODE_ENV=test
PORT=0
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Accept,Accept-Language
CORS_EXPOSED_HEADERS=Location
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=0
{%- if persistence == 'typeorm' %}

# In-process SQLite: the generated suites need no database to be provisioned and
# no container runtime, and each run starts from an empty schema.
DATABASE_DRIVER=sqljs
DATABASE_SYNCHRONIZE=true
{%- endif %}
