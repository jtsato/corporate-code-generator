# Multi-stage build for {{ applicationName }}.
#
# The build stage keeps the full toolchain — the Nest CLI and TypeScript are
# development dependencies — and the runtime stage receives only the compiled
# output and production dependencies.

FROM node:22-alpine AS build
WORKDIR /build

# The manifest is copied before the sources so the dependency layer is reused
# whenever only source files change.
COPY package.json ./
RUN npm install --no-audit --no-fund --loglevel error

COPY . .
RUN npm run build \
 && npm prune --omit=dev

FROM node:22-alpine AS runtime
WORKDIR /app

# Selects `.env.production`, whose CORS origin list is empty. An unconfigured
# container therefore rejects cross-origin browser calls rather than accepting
# all of them.
ENV NODE_ENV=production

# `node:alpine` already ships an unprivileged `node` user (UID/GID 1000), so the
# image adds none of its own.
COPY --from=build --chown=node:node /build/node_modules ./node_modules
COPY --from=build --chown=node:node /build/dist ./dist
COPY --from=build --chown=node:node /build/package.json ./package.json
COPY --from=build --chown=node:node /build/.env.production ./.env.production

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --quiet --spider http://localhost:3000/health-check/ready || exit 1

CMD ["node", "dist/main.js"]
