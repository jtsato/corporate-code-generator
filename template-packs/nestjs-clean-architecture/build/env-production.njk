# Production defaults. Committed, so it must never hold a secret: every value
# here is either safe in the open or deliberately empty for the deployment to
# supply through real environment variables.
#
# CORS is empty rather than permissive. An unconfigured production deployment
# therefore rejects cross-origin browser calls instead of accepting all of them,
# which is the safer of the two failure modes.
NODE_ENV=production
PORT=3000
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Accept,Accept-Language
CORS_EXPOSED_HEADERS=Location
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600
{%- if persistence == 'typeorm' %}

# Deliberately empty: the deployment supplies these as real environment
# variables, and an empty value fails the boot rather than reaching a default
# database nobody meant to use. dotenv never overwrites a variable that is
# already set, so a supplied value wins over the blank below.
DATABASE_DRIVER=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=

# Refused in production anyway; stated here so the value is never a surprise.
DATABASE_SYNCHRONIZE=false
{%- endif %}
