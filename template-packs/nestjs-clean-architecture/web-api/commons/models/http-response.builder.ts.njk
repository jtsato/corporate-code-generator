import { HttpResponse } from './http-response.model';

export class HttpResponseBuilder<T> {
  private status = 200;
  private headers: Record<string, string> = {};
  private body!: T;

  public withStatus(status: number): this {
    this.status = status;
    return this;
  }

  public withHeaders(headers: Record<string, string>): this {
    this.headers = { ...headers };
    return this;
  }

  public withBody(body: T): this {
    this.body = body;
    return this;
  }

  public build(): HttpResponse<T> {
    return new HttpResponse(this.status, this.headers, this.body);
  }
}
