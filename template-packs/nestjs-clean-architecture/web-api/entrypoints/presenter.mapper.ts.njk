{%- set coreRoot = corePackage | default('../../../core') -%}
import { {{ className }} } from '{{ coreRoot }}/models/{{ fileName }}.model';
import { {{ className }}Response } from './{{ fileName }}-response.model';

export class {{ className }}Presenter {
  public static of({{ propertyName }}: {{ className }}): {{ className }}Response {
    const response = new {{ className }}Response();
{%- for property in properties %}
    response.{{ property.name }} = {{ propertyName }}.{{ property.name }};
{%- endfor %}
{%- if audited %}

    // Everything presented here has been through a gateway, so a null creation
    // timestamp means the adapter failed to preserve the stored one. That is a
    // defect, not a state a caller should see rendered as null.
    if ({{ propertyName }}.createdAt === null) {
      throw new Error('{{ className }}Presenter requires a persisted {{ className }}.');
    }

    response.createdAt = {{ propertyName }}.createdAt;
    response.updatedAt = {{ propertyName }}.updatedAt;
{%- endif %}
    return response;
  }
}
