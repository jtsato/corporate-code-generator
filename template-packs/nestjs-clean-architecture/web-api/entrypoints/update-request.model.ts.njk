import { ApiProperty } from '@nestjs/swagger';
import { {{ updateRequestValidationImports | join(", ") }} } from 'class-validator';

export class Update{{ className }}Request {
{%- for property in mutableProperties %}
  @ApiProperty()
{%- if property.required %}
  @IsNotEmpty()
{%- endif %}
  @{{ property.validationDecorator }}()
  public {{ property.name }}: {{ property.type }};
{% endfor -%}
}
