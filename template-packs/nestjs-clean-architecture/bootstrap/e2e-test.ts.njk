import { ValidationPipe } from '@nestjs/common';
import type { INestApplication } from '@nestjs/common';
import { HttpAdapterHost, NestFactory } from '@nestjs/core';
import request = require('supertest');

import { AppModule } from '../src/app.module';
import { ResponseTransformerInterceptor } from '../src/web-api/commons/interceptors/response-transformer.interceptor';

{%- if entities[0].audited %}

/**
 * Audit timestamps are server-generated, so a test cannot name their values.
 * Everything else is compared exactly and these are required only to parse.
 */
function matchesRepresentation(expected: Record<string, unknown>) {
  return ({ body }: { body: Record<string, unknown> }): void => {
    const { createdAt, updatedAt, ...rest } = body as { createdAt: string; updatedAt: string };

    expect(rest).toEqual(expected);
    // Jest's `expect` takes no message argument, so the value is asserted on its
    // own; a failure names the field through the enclosing test.
    expect(Number.isNaN(Date.parse(createdAt))).toBe(false);
    expect(Number.isNaN(Date.parse(updatedAt))).toBe(false);
  };
}

function matchesPageOfOne(expected: Record<string, unknown>) {
  return ({ body }: { body: { items: Record<string, unknown>[]; totalItems: number } }): void => {
    expect(body.totalItems).toBe(1);
    matchesRepresentation(expected)({ body: body.items[0] });
  };
}
{%- endif %}

describe('generated NestJS HTTP API', () => {
  let app: INestApplication;

  beforeAll(async () => {
    app = await NestFactory.create(AppModule);
    app.useGlobalPipes(new ValidationPipe({ transform: true, whitelist: true }));
    app.useGlobalInterceptors(new ResponseTransformerInterceptor(app.get(HttpAdapterHost)));
    await app.init();
  });

  afterAll(async () => {
    await app.close();
  });

  it('serves health and paged response-envelope endpoints', async () => {
    await request(app.getHttpServer())
      .get('/health-check/live')
      .expect(200)
      .expect({ status: 'UP' });

    await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}?page=0&size=20')
      .expect(200)
      .expect({
        items: [],
        page: 0,
        size: 20,
        totalItems: 0,
        totalPages: 0,
      });
  });

  it('serves the generated CRUD lifecycle', async () => {
    const identifier = {{ entities[0].identifier.testValue }};
    const initial = {
{%- for property in entities[0].mutableProperties %}
      {{ property.name }}: {{ property.testValue }},
{%- endfor %}
    };
    const replacement = {
{%- for property in entities[0].mutableProperties %}
      {{ property.name }}: {{ property.alternateTestValue }},
{%- endfor %}
    };
    const patch = {
{%- for property in entities[0].mutableProperties %}
{%- if loop.first %}
      {{ property.name }}: {{ property.testValue }},
{%- endif %}
{%- endfor %}
    };
    const createdRepresentation = { {{ entities[0].identifier.name }}: identifier, ...initial };
    const replacedRepresentation = { {{ entities[0].identifier.name }}: identifier, ...replacement };
    const patchedRepresentation = {
      ...replacedRepresentation,
      ...patch,
      {{ entities[0].identifier.name }}: identifier,
    };

{%- if entities[0].audited %}
    const created = await request(app.getHttpServer())
      .post('/{{ entities[0].pluralFileName }}')
      .send({ {{ entities[0].identifier.name }}: identifier, ...initial })
      .expect(201)
      .expect(matchesRepresentation(createdRepresentation));

    // A fresh record carries one clock reading in both fields.
    expect(created.body.createdAt).toBe(created.body.updatedAt);
{%- else %}
    await request(app.getHttpServer())
      .post('/{{ entities[0].pluralFileName }}')
      .send({ {{ entities[0].identifier.name }}: identifier, ...initial })
      .expect(201)
      .expect(createdRepresentation);
{%- endif %}
{%- if entities[0].hasUniqueAttributes %}

    await request(app.getHttpServer())
      .post('/{{ entities[0].pluralFileName }}')
      .set('Accept-Language', 'pt-BR')
      .send({
        {{ entities[0].identifier.name }}: {{ entities[0].identifier.alternateTestValue }},
{%- for property in entities[0].mutableProperties %}
        {{ property.name }}: {{ property.testValue }}{% if not loop.last %},{% endif %}
{%- endfor %}
      })
      .expect(409)
      .expect({
        statusCode: 409,
        message: '{{ entities[0].className }} já existe.',
      });
{%- endif %}

    await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}/' + identifier)
      .expect(200)
      .expect({% if entities[0].audited %}matchesRepresentation(createdRepresentation){% else %}createdRepresentation{% endif %});

    await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}?page=0&size=20')
      .expect(200)
{%- if entities[0].audited %}
      .expect(matchesPageOfOne(createdRepresentation));
{%- else %}
      .expect({
        items: [createdRepresentation],
        page: 0,
        size: 20,
        totalItems: 1,
        totalPages: 1,
      });
{%- endif %}

{%- if entities[0].mutableProperties.length > 0 %}
{%- if entities[0].audited %}
    const replaced = await request(app.getHttpServer())
      .put('/{{ entities[0].pluralFileName }}/' + identifier)
      .send(replacement)
      .expect(200)
      .expect(matchesRepresentation(replacedRepresentation));

    // The contract, and the one thing no unit test can establish: the creation
    // timestamp survives a write that never supplied it, and only the other moves.
    expect(replaced.body.createdAt).toBe(created.body.createdAt);
    expect(Date.parse(replaced.body.updatedAt))
      .toBeGreaterThanOrEqual(Date.parse(created.body.updatedAt));
{%- else %}
    await request(app.getHttpServer())
      .put('/{{ entities[0].pluralFileName }}/' + identifier)
      .send(replacement)
      .expect(200)
      .expect(replacedRepresentation);
{%- endif %}

{%- if entities[0].audited %}
    const patched = await request(app.getHttpServer())
      .patch('/{{ entities[0].pluralFileName }}/' + identifier)
      .send(patch)
      .expect(200)
      .expect(matchesRepresentation(patchedRepresentation));

    expect(patched.body.createdAt).toBe(created.body.createdAt);
{%- else %}
    await request(app.getHttpServer())
      .patch('/{{ entities[0].pluralFileName }}/' + identifier)
      .send(patch)
      .expect(200)
      .expect(patchedRepresentation);
{%- endif %}

    await request(app.getHttpServer())
      .patch('/{{ entities[0].pluralFileName }}/' + identifier)
      .send({})
      .expect(400);
{%- endif %}

    const deleted = await request(app.getHttpServer())
      .delete('/{{ entities[0].pluralFileName }}/' + identifier)
      .expect(204);
    expect(deleted.text).toBe('');

    await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}/' + identifier)
      .expect(404);

    await request(app.getHttpServer())
      .delete('/{{ entities[0].pluralFileName }}/' + identifier)
      .expect(404);
  });

  it('retains a deleted record and restores it', async () => {
    const identifier = {{ entities[0].identifier.alternateTestValue }};
    const representation = {
      {{ entities[0].identifier.name }}: identifier,
{%- for property in entities[0].mutableProperties %}
      {{ property.name }}: {{ property.testValue }},
{%- endfor %}
    };

    await request(app.getHttpServer())
      .post('/{{ entities[0].pluralFileName }}')
      .send(representation)
      .expect(201);

    await request(app.getHttpServer())
      .delete('/{{ entities[0].pluralFileName }}/' + identifier)
      .expect(204);

    // Deleting hides the row from the active routes; it does not remove it.
    await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}/' + identifier)
      .expect(404);

    const tombstone = await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}/deleted/' + identifier)
      .expect(200);
    expect(tombstone.body).toMatchObject(representation);
    expect(typeof tombstone.body.deletedAt).toBe('string');

    // `/deleted` is declared before `/:id`, so it is a route rather than an
    // identifier. Were the order reversed this would be a 400 for a malformed
    // identifier instead of a page. Earlier cases leave tombstones of their own,
    // so this asserts membership rather than a total.
    const deletedPage = await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}/deleted?page=0&size=20')
      .expect(200);
    expect(deletedPage.body.items.some(
      (item: { {{ entities[0].identifier.name }}: {{ entities[0].identifier.type }} }) => item.{{ entities[0].identifier.name }} === identifier,
    )).toBe(true);

    const restored = await request(app.getHttpServer())
      .post('/{{ entities[0].pluralFileName }}/' + identifier + '/restore')
      .expect(204);
    expect(restored.text).toBe('');

    await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}/' + identifier)
      .expect(200)
      .expect({% if entities[0].audited %}matchesRepresentation(representation){% else %}representation{% endif %});

    // Restoring an active record is a refusal, not an absence.
    await request(app.getHttpServer())
      .post('/{{ entities[0].pluralFileName }}/' + identifier + '/restore')
      .expect(409);

    await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}/deleted/' + identifier)
      .expect(404);

    await request(app.getHttpServer())
      .delete('/{{ entities[0].pluralFileName }}/' + identifier)
      .expect(204);
  });

  it('negotiates the response language from Accept-Language', async () => {
    const invalidIdentifier = '/{{ entities[0].pluralFileName }}/not-a-uuid';

    // Supported: the weighted header prefers Portuguese over an unsupported tag.
    await request(app.getHttpServer())
      .get(invalidIdentifier)
      .set('Accept-Language', 'fr-FR;q=0.9, pt-BR;q=1.0')
      .expect(400)
      .expect(({ body }) => {
        expect(body.message).toBe('Falha de validação');
      });

    // Unsupported: served in the fallback language rather than rejected.
    await request(app.getHttpServer())
      .get(invalidIdentifier)
      .set('Accept-Language', 'fr-FR')
      .expect(400)
      .expect(({ body }) => {
        expect(body.message).toBe('Validation failed');
      });

    // Missing: the same deterministic fallback.
    await request(app.getHttpServer())
      .get(invalidIdentifier)
      .expect(400)
      .expect(({ body }) => {
        expect(body.message).toBe('Validation failed');
      });
  });

  it('localizes validation and uniqueness errors from Accept-Language', async () => {
    await request(app.getHttpServer())
      .post('/{{ entities[0].pluralFileName }}')
      .send({ {{ entities[0].identifier.name }}: 'not-a-uuid' })
      .expect(400);

    await request(app.getHttpServer())
      .get('/{{ entities[0].pluralFileName }}/not-a-uuid')
      .set('Accept-Language', 'pt-BR')
      .expect(400)
      .expect({
        statusCode: 400,
        message: 'Falha de validação',
        violations: [{ field: '{{ entities[0].identifier.name }}', message: '{{ entities[0].identifier.name }} has an invalid value' }],
      });
  });
});
