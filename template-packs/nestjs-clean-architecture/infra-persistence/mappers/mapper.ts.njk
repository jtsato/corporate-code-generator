{%- set coreRoot = corePackage | default('../../core') -%}
import { {{ className }} } from '{{ coreRoot }}/models/{{ fileName }}.model';
import { {{ className }}Tombstone } from '{{ coreRoot }}/models/{{ fileName }}-tombstone.model';
import { {{ className }}Entity } from '../models/{{ fileName }}-entity.model';

export class {{ className }}Mapper {
  public static toEntity({{ propertyName }}: {{ className }}): {{ className }}Entity {
{%- if audited %}
    const entity = new {{ className }}Entity(
{%- for property in properties %}
      {{ propertyName }}.{{ property.name }},
{%- endfor %}
    );

    // `createdAt` is copied only when the domain object carries one, which is
    // true on creation and false on every update. Leaving it alone is what lets
    // `Update{{ className }}Provider` write the stored value back instead.
    if ({{ propertyName }}.createdAt !== null) {
      entity.createdAt = {{ propertyName }}.createdAt;
    }

    entity.updatedAt = {{ propertyName }}.updatedAt;

    return entity;
{%- else %}
    return new {{ className }}Entity(
{%- for property in properties %}
      {{ propertyName }}.{{ property.name }},
{%- endfor %}
    );
{%- endif %}
  }

  public static toDomain(entity: {{ className }}Entity): {{ className }} {
    return new {{ className }}(
{%- for property in properties %}
      entity.{{ property.name }},
{%- endfor %}
{%- if audited %}
      entity.createdAt,
      entity.updatedAt,
{%- endif %}
    );
  }

  public static toTombstone(entity: {{ className }}Entity): {{ className }}Tombstone {
    // Loud rather than lenient. Only the deleted-only queries reach this, so a
    // null timestamp here means the query stopped filtering by deletion, and a
    // fabricated date would hide that behind a plausible response.
    if (entity.deletedAt === null || entity.deletedAt === undefined) {
      throw new Error('{{ className }}Mapper.toTombstone requires a soft-deleted row.');
    }

    return new {{ className }}Tombstone(
{%- for property in properties %}
      entity.{{ property.name }},
{%- endfor %}
      entity.deletedAt,
    );
  }
}
