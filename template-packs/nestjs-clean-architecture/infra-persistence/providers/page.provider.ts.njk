{%- set coreRoot = corePackage | default('../../core') -%}
import { Injectable } from '@nestjs/common';

import { FilterExpression } from '{{ coreRoot }}/common/filter/filter-expression';
import { PageRequest } from '{{ coreRoot }}/common/paging/page-request';
import { PageResult } from '{{ coreRoot }}/common/paging/page-result';
import { {{ className }} } from '{{ coreRoot }}/models/{{ fileName }}.model';
import { IPage{{ className }}Gateway } from '{{ coreRoot }}/usecases/page-{{ pluralFileName }}/page-{{ pluralFileName }}.gateway';
import { {{ className }}Mapper } from '../mappers/{{ fileName }}.mapper';
import { {{ className }}Repository } from '../repositories/{{ fileName }}.repository';

@Injectable()
export class Page{{ className }}Provider implements IPage{{ className }}Gateway {
  public constructor(private readonly repository: {{ className }}Repository) {}

  public async execute(pageRequest: PageRequest, filterExpression: FilterExpression): Promise<PageResult<{{ className }}>> {
    const page = await this.repository.findPage(pageRequest, filterExpression);
    return new PageResult(
      page.items.map({{ className }}Mapper.toDomain),
      page.page,
      page.size,
      page.totalItems,
    );
  }
}
