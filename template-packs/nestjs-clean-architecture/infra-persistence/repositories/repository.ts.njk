import { Injectable } from '@nestjs/common';

import { FilterExpression } from '../../core/common/filter/filter-expression';
import { PageRequest } from '../../core/common/paging/page-request';
import { PageResult } from '../../core/common/paging/page-result';
import { {{ className }}Entity } from '../models/{{ fileName }}-entity.model';

function compareStrings(left: string, right: string): number {
  if (left < right) return -1;
  if (left > right) return 1;
  return 0;
}

function isNullish(value: unknown): boolean {
  return value === null || value === undefined;
}

function compareValues(left: unknown, right: unknown): number {
  if (isNullish(left)) return isNullish(right) ? 0 : 1;
  if (isNullish(right)) return -1;
  if (left instanceof Date && right instanceof Date) return left.getTime() - right.getTime();
  if (typeof left === 'number' && typeof right === 'number') return left - right;
  if (typeof left === 'boolean' && typeof right === 'boolean') return Number(left) - Number(right);
  return compareStrings(String(left), String(right));
}

function isActive(entity: {{ className }}Entity): boolean {
  return isNullish(entity.deletedAt);
}

@Injectable()
export class {{ className }}Repository {
  private readonly {{ propertyName }}s: {{ className }}Entity[] = [];

  public async save(entity: {{ className }}Entity): Promise<{{ className }}Entity> {
    this.{{ propertyName }}s.push(entity);
    return Promise.resolve(entity);
  }

  public async findById({{ identifier.name }}: {{ identifier.type }}): Promise<{{ className }}Entity | undefined> {
    return Promise.resolve(
      this.{{ propertyName }}s.find((entity) => isActive(entity) && entity.{{ identifier.name }} === {{ identifier.name }}),
    );
  }

  /**
   * Resolves a row whether it is active or soft-deleted.
   *
   * Restore needs this: it has to tell "no such row" from "already active", and
   * an active-only lookup collapses those two into the same absence.
   */
  public async findAnyById({{ identifier.name }}: {{ identifier.type }}): Promise<{{ className }}Entity | undefined> {
    return Promise.resolve(
      this.{{ propertyName }}s.find((entity) => entity.{{ identifier.name }} === {{ identifier.name }}),
    );
  }

  public async findDeletedById({{ identifier.name }}: {{ identifier.type }}): Promise<{{ className }}Entity | undefined> {
    return Promise.resolve(
      this.{{ propertyName }}s.find((entity) => !isActive(entity) && entity.{{ identifier.name }} === {{ identifier.name }}),
    );
  }

  public async updateById({{ identifier.name }}: {{ identifier.type }}, entity: {{ className }}Entity): Promise<{{ className }}Entity | undefined> {
    const index = this.{{ propertyName }}s.findIndex((current) => isActive(current) && current.{{ identifier.name }} === {{ identifier.name }});
    if (index < 0) return undefined;
    this.{{ propertyName }}s[index] = entity;
    return entity;
  }

  /**
   * Marks the row deleted and keeps it. Returns false when no *active* row
   * carries the identifier, which is what makes a repeated delete a 404 rather
   * than a second success.
   */
  public async softDeleteById({{ identifier.name }}: {{ identifier.type }}, deletedAt: Date): Promise<boolean> {
    const entity = this.{{ propertyName }}s.find((current) => isActive(current) && current.{{ identifier.name }} === {{ identifier.name }});
    if (entity === undefined) return false;
    entity.deletedAt = deletedAt;
    return true;
  }

  /** Clears the marker. The caller has already decided the row may be restored. */
  public async restoreById({{ identifier.name }}: {{ identifier.type }}): Promise<boolean> {
    const entity = this.{{ propertyName }}s.find((current) => !isActive(current) && current.{{ identifier.name }} === {{ identifier.name }});
    if (entity === undefined) return false;
    entity.deletedAt = null;
    return true;
  }

  public async existsById({{ identifier.name }}: {{ identifier.type }}): Promise<boolean> {
    return Promise.resolve(this.{{ propertyName }}s.some((current) =>
      isActive(current) && compareValues(current.{{ identifier.name }}, {{ identifier.name }}) === 0,
    ));
  }

  /**
   * Whether the identifier is taken at all, tombstones included.
   *
   * Soft delete releases a unique *business* value but never the identifier: the
   * row that holds it still exists, and restore is how it comes back. Creating
   * over it would either resurrect a tombstone or leave two rows sharing an
   * identifier, depending on the adapter — which is exactly the kind of
   * divergence the two persistence options must not have.
   */
  public async existsAnyById({{ identifier.name }}: {{ identifier.type }}): Promise<boolean> {
    return Promise.resolve(this.{{ propertyName }}s.some((current) =>
      compareValues(current.{{ identifier.name }}, {{ identifier.name }}) === 0,
    ));
  }

{%- if hasUniqueAttributes %}
  /**
   * Considers active rows only, which is what lets a unique value be reused
   * after the row holding it was soft-deleted. A restored row has to pass this
   * check again, because the value may have been taken meanwhile.
   */
  public async hasUniqueConflict(
    candidate: {{ className }}Entity,
    ignoredIdentifier?: {{ identifier.type }},
  ): Promise<readonly string[]> {
    const conflicts = new Set<string>();

    for (const current of this.{{ propertyName }}s) {
      if (!isActive(current)) continue;
      if (ignoredIdentifier !== undefined && compareValues(current.{{ identifier.name }}, ignoredIdentifier) === 0) continue;
{%- for attribute in uniqueAttributes %}
      if (!isNullish(candidate.{{ attribute.name }}) && compareValues(current.{{ attribute.name }}, candidate.{{ attribute.name }}) === 0) {
        conflicts.add('{{ attribute.name }}');
