{%- endfor %}
{%- for group in uniqueGroupChecks %}
      if (
{%- for attribute in group.attributes %}
        !isNullish(candidate.{{ attribute.name }}) &&
        compareValues(current.{{ attribute.name }}, candidate.{{ attribute.name }}) === 0{% if not loop.last %} &&{% endif %}
{%- endfor %}
      ) {
{%- for attribute in group.attributes %}
        conflicts.add('{{ attribute.name }}');
{%- endfor %}
