import { FilterExpression } from '../../core/common/filter/filter-expression';
import { PageRequest } from '../../core/common/paging/page-request';
import { SortDirection } from '../../core/common/paging/sort-direction';
import { SortOrder } from '../../core/common/paging/sort-order';
import { {{ className }}Entity } from '../models/{{ fileName }}-entity.model';
import { {{ className }}Repository } from './{{ fileName }}.repository';

describe('{{ className }}Repository', () => {
  function createEntity(propertyName: string, value: unknown): {{ className }}Entity {
    return new {{ className }}Entity(
{%- for property in properties %}
      propertyName === '{{ property.name }}' ? value as unknown as {{ property.type }} : {{ property.testValue }},
{%- endfor %}
    );
  }

{%- if hasUniqueAttributes %}
  function createEntityWith(overrides: Record<string, unknown>): {{ className }}Entity {
    return new {{ className }}Entity(
{%- for property in properties %}
      Object.prototype.hasOwnProperty.call(overrides, '{{ property.name }}')
        ? overrides['{{ property.name }}'] as unknown as {{ property.type }}
        : {{ property.testValue }},
{%- endfor %}
    );
  }
{%- endif %}

  async function sortedItems(
    repository: {{ className }}Repository,
    property: string,
    direction: SortDirection,
  ): Promise<readonly {{ className }}Entity[]> {
    const result = await repository.findPage(
      new PageRequest(0, 20, [new SortOrder(property, direction)]),
      new FilterExpression(),
    );
    return result.items;
  }

  it('reports whether an identifier exists', async () => {
    const repository = new {{ className }}Repository();
    const entity = createEntity('{{ identifier.name }}', {{ identifier.testValue }});

    await repository.save(entity);

    await expect(repository.existsById({{ identifier.testValue }})).resolves.toBe(true);
    await expect(repository.existsById({{ identifier.alternateTestValue }})).resolves.toBe(false);
  });

  it('retains a soft-deleted row and hides it from every active read', async () => {
    const repository = new {{ className }}Repository();
    const deletedAt = new Date('2025-06-01T00:00:00.000Z');
    await repository.save(createEntity('{{ identifier.name }}', {{ identifier.testValue }}));

    await expect(repository.softDeleteById({{ identifier.testValue }}, deletedAt)).resolves.toBe(true);

    await expect(repository.findById({{ identifier.testValue }})).resolves.toBeUndefined();
    await expect(repository.existsById({{ identifier.testValue }})).resolves.toBe(false);
    await expect(repository.findPage(new PageRequest(0, 20, []), new FilterExpression()))
      .resolves.toMatchObject({ totalItems: 0 });

    // Retained, not removed: that is the whole difference from a hard delete.
    const tombstone = await repository.findDeletedById({{ identifier.testValue }});
    expect(tombstone).toBeDefined();
    expect((tombstone as {{ className }}Entity).deletedAt).toEqual(deletedAt);
    await expect(repository.findDeletedPage(new PageRequest(0, 20, []), new FilterExpression()))
      .resolves.toMatchObject({ totalItems: 1 });
  });

  it('reports a repeated soft delete as nothing to delete', async () => {
    // What makes a second DELETE answer 404 instead of 204.
    const repository = new {{ className }}Repository();
    await repository.save(createEntity('{{ identifier.name }}', {{ identifier.testValue }}));

    await expect(repository.softDeleteById({{ identifier.testValue }}, new Date())).resolves.toBe(true);
    await expect(repository.softDeleteById({{ identifier.testValue }}, new Date())).resolves.toBe(false);
  });

  it('restores a tombstone back into the active reads', async () => {
    const repository = new {{ className }}Repository();
    await repository.save(createEntity('{{ identifier.name }}', {{ identifier.testValue }}));
    await repository.softDeleteById({{ identifier.testValue }}, new Date());

    await expect(repository.restoreById({{ identifier.testValue }})).resolves.toBe(true);

    await expect(repository.findById({{ identifier.testValue }})).resolves.toBeDefined();
    await expect(repository.findDeletedById({{ identifier.testValue }})).resolves.toBeUndefined();
    // Restoring one that is already active is nothing to restore, which the
    // provider turns into a conflict rather than a silent success.
    await expect(repository.restoreById({{ identifier.testValue }})).resolves.toBe(false);
  });

  it('resolves a row by identifier whether it is active or deleted', async () => {
    // Restore needs this to tell "no such row" from "already active".
    const repository = new {{ className }}Repository();
    await repository.save(createEntity('{{ identifier.name }}', {{ identifier.testValue }}));

    await expect(repository.findAnyById({{ identifier.testValue }})).resolves.toBeDefined();
    await repository.softDeleteById({{ identifier.testValue }}, new Date());
    await expect(repository.findAnyById({{ identifier.testValue }})).resolves.toBeDefined();
    await expect(repository.findAnyById({{ identifier.alternateTestValue }})).resolves.toBeUndefined();
  });

  it('keeps nullish values after present values for descending sort', async () => {
    const repository = new {{ className }}Repository();
    const present = createEntity('{{ identifier.name }}', {{ identifier.testValue }});
    const nullValue = createEntity('{{ identifier.name }}', null);
    const undefinedValue = createEntity('{{ identifier.name }}', undefined);

    await repository.save(present);
    await repository.save(nullValue);
    await repository.save(undefinedValue);

    await expect(sortedItems(repository, '{{ identifier.name }}', SortDirection.Desc)).resolves.toEqual([
      present,
      nullValue,
      undefinedValue,
    ]);
  });

  it('keeps nullish values after present values for ascending sort', async () => {
    const repository = new {{ className }}Repository();
    const present = createEntity('{{ identifier.name }}', {{ identifier.testValue }});
    const nullValue = createEntity('{{ identifier.name }}', null);
    const undefinedValue = createEntity('{{ identifier.name }}', undefined);

    await repository.save(present);
    await repository.save(nullValue);
    await repository.save(undefinedValue);

    await expect(sortedItems(repository, '{{ identifier.name }}', SortDirection.Asc)).resolves.toEqual([
      present,
      nullValue,
      undefinedValue,
    ]);
  });
{%- for property in properties %}
{%- if property.type == 'number' %}

  it('compares numeric values numerically', async () => {
    const repository = new {{ className }}Repository();
    const ten = createEntity('{{ property.name }}', 10);
    const two = createEntity('{{ property.name }}', 2);

    await repository.save(ten);
    await repository.save(two);

    await expect(sortedItems(repository, '{{ property.name }}', SortDirection.Asc)).resolves.toEqual([
      two,
      ten,
    ]);
  });
{%- elif property.type == 'boolean' %}

  it('orders booleans as false before true', async () => {
    const repository = new {{ className }}Repository();
    const trueValue = createEntity('{{ property.name }}', true);
    const falseValue = createEntity('{{ property.name }}', false);

    await repository.save(trueValue);
    await repository.save(falseValue);

    await expect(sortedItems(repository, '{{ property.name }}', SortDirection.Asc)).resolves.toEqual([
      falseValue,
      trueValue,
    ]);
  });
{%- elif property.type == 'Date' %}

  it('compares dates by epoch milliseconds', async () => {
    const repository = new {{ className }}Repository();
    const later = createEntity('{{ property.name }}', new Date('2025-01-02T00:00:00.000Z'));
    const earlier = createEntity('{{ property.name }}', new Date('2025-01-01T00:00:00.000Z'));

    await repository.save(later);
    await repository.save(earlier);

    await expect(sortedItems(repository, '{{ property.name }}', SortDirection.Asc)).resolves.toEqual([
      earlier,
      later,
    ]);
  });
{%- elif property.type == 'string' %}

  it('compares strings deterministically without locale dependence', async () => {
    const repository = new {{ className }}Repository();
    const b = createEntity('{{ property.name }}', 'b');
    const a = createEntity('{{ property.name }}', 'a');

    await repository.save(b);
    await repository.save(a);

    await expect(sortedItems(repository, '{{ property.name }}', SortDirection.Asc)).resolves.toEqual([
      a,
      b,
    ]);
  });
{%- endif %}
{%- endfor %}

{%- if hasUniqueAttributes %}
  it('reports no unique conflict for an empty repository', async () => {
    const repository = new {{ className }}Repository();

    await expect(repository.hasUniqueConflict(createEntity('{{ identifier.name }}', {{ identifier.testValue }}))).resolves.toEqual([]);
  });

  it('releases a unique value while the row holding it is deleted', async () => {
    // The point of soft delete rather than a reserved-forever tombstone: the
    // value returns to circulation, and the restore path has to cope with the
    // possibility that something else took it.
    const repository = new {{ className }}Repository();
    await repository.save(createEntityWith({ {{ identifier.name }}: {{ identifier.testValue }} }));
    const candidate = createEntityWith({ {{ identifier.name }}: {{ identifier.alternateTestValue }} });

    await expect(repository.hasUniqueConflict(candidate)).resolves.not.toEqual([]);

    await repository.softDeleteById({{ identifier.testValue }}, new Date());

    await expect(repository.hasUniqueConflict(candidate)).resolves.toEqual([]);
  });
{%- for attribute in uniqueAttributes %}

  it('reports a conflict for duplicate {{ attribute.name }}', async () => {
    const repository = new {{ className }}Repository();

    await repository.save(createEntityWith({ {{ identifier.name }}: {{ identifier.testValue }}, {{ attribute.name }}: {{ attribute.testValue }} }));

    const candidate = createEntityWith({ {{ identifier.name }}: {{ identifier.alternateTestValue }}, {{ attribute.name }}: {{ attribute.testValue }} });

    await expect(repository.hasUniqueConflict(candidate)).resolves.toContain('{{ attribute.name }}');
  });

  it('ignores the same record for {{ attribute.name }}', async () => {
    const repository = new {{ className }}Repository();
    const existing = createEntityWith({ {{ identifier.name }}: {{ identifier.testValue }}, {{ attribute.name }}: {{ attribute.testValue }} });

    await repository.save(existing);

    await expect(repository.hasUniqueConflict(existing, existing.{{ identifier.name }})).resolves.toEqual([]);
  });

  it('skips nullish {{ attribute.name }} values', async () => {
    const repository = new {{ className }}Repository();

    await repository.save(createEntityWith({ {{ identifier.name }}: {{ identifier.testValue }}, {{ attribute.name }}: null }));

    const candidate = createEntityWith({ {{ identifier.name }}: {{ identifier.alternateTestValue }}, {{ attribute.name }}: null });

    await expect(repository.hasUniqueConflict(candidate)).resolves.not.toContain('{{ attribute.name }}');
  });
{%- endfor %}
{%- for group in uniqueGroupChecks %}

  it('requires all non-null members of a unique group {{ loop.index }}', async () => {
    const repository = new {{ className }}Repository();

    await repository.save(createEntityWith({ {{ identifier.name }}: {{ identifier.testValue }}, {% for attribute in group.attributes %}{{ attribute.name }}: {{ attribute.testValue }}{% if not loop.last %}, {% endif %}{% endfor %} }));

    const candidate = createEntityWith({ {{ identifier.name }}: {{ identifier.alternateTestValue }}, {% for attribute in group.attributes %}{{ attribute.name }}: {{ attribute.testValue }}{% if not loop.last %}, {% endif %}{% endfor %} });

    await expect(repository.hasUniqueConflict(candidate)).resolves.toEqual(expect.arrayContaining([
{%- for attribute in group.attributes %}
      '{{ attribute.name }}'{% if not loop.last %},{% endif %}
{%- endfor %}
    ]));
  });

  it('skips a unique group {{ loop.index }} when a member is nullish', async () => {
    const repository = new {{ className }}Repository();

    await repository.save(createEntityWith({ {{ identifier.name }}: {{ identifier.testValue }}, {% for attribute in group.attributes %}{{ attribute.name }}: {{ attribute.testValue }}{% if not loop.last %}, {% endif %}{% endfor %} }));

    const candidate = createEntityWith({ {{ identifier.name }}: {{ identifier.alternateTestValue }}, {% for attribute in group.attributes %}{% if loop.first %}{{ attribute.name }}: null{% else %}{{ attribute.name }}: {{ attribute.testValue }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %} });

    await expect(repository.hasUniqueConflict(candidate)).resolves.toEqual([]);
  });
{%- endfor %}
{%- endif %}
});
