    @Test void shouldCalculatePagingMetadata() { var result = new PageResult<>(List.of("a"), 1, 10, 30); assertEquals(3, result.totalPages()); assertTrue(result.hasNext()); assertTrue(result.hasPrevious()); assertFalse(result.isEmpty()); assertFalse(new PageResult<>(List.of(), 0, 10, 0).hasPrevious()); assertFalse(new PageResult<>(List.of(), 2, 10, 30).hasNext()); assertTrue(new PageResult<>(List.of(), 0, 10, 0).isEmpty()); }
    @Test void shouldCopyItemsAndAllowPageBeyondTotalItems() { var items = new ArrayList<>(List.of("a")); var result = new PageResult<>(items, 10, 20, 0); items.clear(); assertEquals(1, result.items().size()); assertThrows(UnsupportedOperationException.class, () -> result.items().add("b")); }
    @Test void shouldRejectInvalidMetadata() { assertKey("common.paging.items.required", () -> new PageResult<String>(null, 0, 1, 0)); assertKey("common.paging.items.null-element", () -> new PageResult<>(java.util.Arrays.asList("a", null), 0, 1, 0)); assertKey("common.paging.page.invalid", () -> new PageResult<>(List.of(), -1, 1, 0)); assertKey("common.paging.size.invalid", () -> new PageResult<>(List.of(), 0, 0, 0)); assertKey("common.paging.total-items.invalid", () -> new PageResult<>(List.of(), 0, 1, -1)); }
    private static void assertKey(String key, org.junit.jupiter.api.function.Executable executable) { assertEquals(key, assertThrows(ValidationException.class, executable).getFields().getFirst().messageKey()); }
