package {{ packageName }};

{% for import in imports %}import {{ import }};
{% endfor %}
public record {{ className }}(
{% for field in fields %}    {{ field.type }} {{ field.name }}{% if not loop.last %},{% endif %}
{% endfor %}) {
    public {{ className }} {
        var fields = new java.util.ArrayList<FieldViolation>();
{% for field in fields %}        if ({{ field.name }} == null) {
            fields.add(new FieldViolation(
                "{{ field.name }}",
                "{{ field.requiredMessageKey }}",
                "{{ field.requiredDefaultMessage }}"
            ));
        }
{% endfor %}        if (!fields.isEmpty()) {
            throw new ValidationException(fields);
        }
    }
}
