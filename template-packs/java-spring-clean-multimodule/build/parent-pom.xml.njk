<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>{{ modelVersion }}</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>{{ springBootVersion }}</version>
    <relativePath/>
  </parent>

  <groupId>{{ groupId }}</groupId>
  <artifactId>{{ artifactId }}</artifactId>
  <version>{{ version }}</version>
  <packaging>pom</packaging>

  <name>{{ name }}</name>

  <modules>
{% for module in modules %}    <module>{{ module }}</module>
{% endfor %}  </modules>

  <properties>
    <java.version>{{ javaVersion }}</java.version>
    <maven.compiler.release>{{ javaVersion }}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <archunit.version>{{ archUnitVersion }}</archunit.version>
    <springdoc-openapi.version>{{ springdocOpenapiVersion }}</springdoc-openapi.version>
    <!-- Deliberately not `querydsl.version`: Spring Boot's own BOM imports
         com.querydsl:querydsl-bom through that property, so overriding it would
         retarget Boot's import at a groupId the fork does not publish. -->
    <openfeign-querydsl.version>{{ querydslVersion }}</openfeign-querydsl.version>
    <jakarta-persistence.version>{{ jakartaPersistenceVersion }}</jakarta-persistence.version>
    <jakarta-annotation.version>{{ jakartaAnnotationVersion }}</jakarta-annotation.version>
    <expressly.version>{{ expresslyVersion }}</expressly.version>
    <jacoco-maven-plugin.version>{{ jacocoVersion }}</jacoco-maven-plugin.version>
    <pitest-maven-plugin.version>{{ pitestVersion }}</pitest-maven-plugin.version>
    <pitest-junit5-plugin.version>{{ pitestJunit5PluginVersion }}</pitest-junit5-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
{% for dependency in managedDependencies %}      <dependency>
        <groupId>{{ dependency.groupId }}</groupId>
        <artifactId>{{ dependency.artifactId }}</artifactId>
        <version>{{ dependency.version }}</version>
{% if dependency.classifier %}        <classifier>{{ dependency.classifier }}</classifier>
{% endif %}      </dependency>
{% endfor %}    </dependencies>
  </dependencyManagement>

  <dependencies>
{% for dependency in sharedDependencies %}    <dependency>
      <groupId>{{ dependency.groupId }}</groupId>
      <artifactId>{{ dependency.artifactId }}</artifactId>
{% if dependency.scope %}      <scope>{{ dependency.scope }}</scope>
{% endif %}    </dependency>
{% endfor %}  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>{{ coverageLineMinimum }}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
