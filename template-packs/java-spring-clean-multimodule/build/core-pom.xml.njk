<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>{{ modelVersion }}</modelVersion>

  <parent>
    <groupId>{{ parentGroupId }}</groupId>
    <artifactId>{{ parentArtifactId }}</artifactId>
    <version>{{ parentVersion }}</version>
    <relativePath>{{ parentRelativePath }}</relativePath>
  </parent>

  <artifactId>{{ artifactId }}</artifactId>
  <packaging>{{ packaging }}</packaging>

  <dependencies>
{% for dependency in dependencies %}    <dependency>
      <groupId>{{ dependency.groupId }}</groupId>
      <artifactId>{{ dependency.artifactId }}</artifactId>
{% if dependency.scope %}      <scope>{{ dependency.scope }}</scope>
{% endif %}    </dependency>
{% endfor %}  </dependencies>
{% if mutationTesting %}
  <profiles>
    <profile>
      <id>{{ mutationTesting.profileId }}</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest-maven-plugin.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5-plugin.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>pitest-mutation-coverage</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <targetClasses>
{% for targetClass in mutationTesting.targetClasses %}                <param>{{ targetClass }}</param>
{% endfor %}              </targetClasses>
              <targetTests>
{% for targetTest in mutationTesting.targetTests %}                <param>{{ targetTest }}</param>
{% endfor %}              </targetTests>
              <outputFormats>
{% for outputFormat in mutationTesting.outputFormats %}                <param>{{ outputFormat }}</param>
{% endfor %}              </outputFormats>
              <timestampedReports>{{ mutationTesting.timestampedReports }}</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
{% endif %}</project>
