package {{ packageName }};

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import {{ exceptionPackageName }}.ValidationException;
import {{ pagingPackageName }}.PageRequest;
import {{ pagingPackageName }}.SortOrder;
import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.Test;

class {{ className }} {
    @Test void shouldMapPageAndSize() { var pageable = SpringDataPageRequestMapper.toPageable(PageRequest.of(2, 50), Map.of()); assertEquals(2, pageable.getPageNumber()); assertEquals(50, pageable.getPageSize()); }
    @Test void shouldMapAscendingAndDescendingSorts() { var ascending = SpringDataPageRequestMapper.toPageable(PageRequest.of(0, 20, List.of(SortOrder.asc("balance"))), Map.of("balance", "balance")).getSort().iterator().next(); var descending = SpringDataPageRequestMapper.toPageable(PageRequest.of(0, 20, List.of(SortOrder.desc("balance"))), Map.of("balance", "balance")).getSort().iterator().next(); assertEquals("balance", ascending.getProperty()); assertEquals(org.springframework.data.domain.Sort.Direction.ASC, ascending.getDirection()); assertEquals(org.springframework.data.domain.Sort.Direction.DESC, descending.getDirection()); }
    @Test void shouldPreserveMultipleSortOrder() { var orders = SpringDataPageRequestMapper.toPageable(PageRequest.of(0, 20, List.of(SortOrder.asc("id"), SortOrder.desc("balance"))), Map.of("id", "id", "balance", "balance")).getSort().toList(); assertEquals(List.of("id", "balance"), orders.stream().map(org.springframework.data.domain.Sort.Order::getProperty).toList()); assertEquals(org.springframework.data.domain.Sort.Direction.DESC, orders.get(1).getDirection()); }
    @Test void shouldRejectInvalidInput() { assertViolation("sort", "common.paging.sort.property.unsupported", () -> SpringDataPageRequestMapper.toPageable(PageRequest.of(0, 20, List.of(SortOrder.asc("createdAt"))), Map.of())); assertViolation("pageRequest", "common.paging.page-request.required", () -> SpringDataPageRequestMapper.toPageable(null, Map.of())); assertViolation("sortPropertyMapping", "common.paging.sort.mapping.required", () -> SpringDataPageRequestMapper.toPageable(PageRequest.defaultPage(), null)); assertViolation("sortPropertyMapping", "common.paging.sort.mapping.invalid", () -> SpringDataPageRequestMapper.toPageable(PageRequest.of(0, 20, List.of(SortOrder.asc("balance"))), Map.of("balance", ""))); }
    private static void assertViolation(String name, String key, org.junit.jupiter.api.function.Executable executable) { var violation = assertThrows(ValidationException.class, executable).getFields().getFirst(); assertEquals(name, violation.name()); assertEquals(key, violation.messageKey()); }
}
