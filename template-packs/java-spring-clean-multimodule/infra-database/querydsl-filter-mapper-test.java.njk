import static org.junit.jupiter.api.Assertions.*; import com.querydsl.core.types.dsl.Expressions; import {{ filterPackage }}.*; import java.util.*; import org.junit.jupiter.api.Test;
class QuerydslFilterMapperTests { @Test void shouldReturnEmptyPredicateForEmptyExpression() { assertTrue(QuerydslFilterMapper.toPredicate(FilterExpression.empty(), definition()).isEmpty()); } @Test void shouldMapAndGroups() { var condition = FilterCondition.of("amount", FilterOperator.GREATER_THAN, "2"); assertTrue(QuerydslFilterMapper.toPredicate(FilterExpression.of(FilterGroup.and(List.of(condition))), definition()).isPresent()); } @Test void shouldRejectUnsupportedField() { var condition = FilterCondition.of("none", FilterOperator.EQUALS, "2"); assertThrows(RuntimeException.class, () -> QuerydslFilterMapper.toPredicate(FilterExpression.of(FilterGroup.and(List.of(condition))), definition())); } private static QuerydslFilterDefinition definition() { return QuerydslFilterDefinition.of(List.of(QuerydslFilterFieldDefinition.of("amount", Integer.class, Map.of(FilterOperator.GREATER_THAN, values -> Expressions.numberPath(Integer.class, "amount").gt(values.get(0)))))); } }
