public final class QuerydslFilterFieldDefinition<T> {
    @FunctionalInterface public interface Operation<T> { BooleanExpression apply(List<T> values); }
    private final String domainName; private final Class<T> valueType; private final Map<FilterOperator, Operation<T>> operations;
    private QuerydslFilterFieldDefinition(String domainName, Class<T> valueType, Map<FilterOperator, Operation<T>> operations) { this.domainName = domainName; this.valueType = valueType; this.operations = operations; }
    public static <T> QuerydslFilterFieldDefinition<T> of(String domainName, Class<T> valueType, Map<FilterOperator, Operation<T>> operations) { if (domainName == null || domainName.isBlank()) throw validation("domainName", "common.querydsl.filter.field.domain-name.required", "Filter domain name is required."); if (valueType == null) throw validation("valueType", "common.querydsl.filter.field.value-type.required", "Filter value type is required."); if (operations == null) throw validation("operations", "common.querydsl.filter.field.operations.required", "Filter operations are required."); if (operations.isEmpty()) throw validation("operations", "common.querydsl.filter.field.operations.empty", "Filter operations must not be empty."); for (var entry : operations.entrySet()) { if (entry.getKey() == null) throw validation("operations", "common.querydsl.filter.field.operations.null-key", "Filter operations must not contain null keys."); if (entry.getValue() == null) throw validation("operations", "common.querydsl.filter.field.operations.null-value", "Filter operations must not contain null values."); } return new QuerydslFilterFieldDefinition<>(domainName, valueType, Map.copyOf(new LinkedHashMap<>(operations))); }
    public String domainName() { return domainName; } public Class<T> valueType() { return valueType; } public Set<FilterOperator> supportedOperators() { return operations.keySet(); } public Optional<Operation<T>> findOperation(FilterOperator operator) { return Optional.ofNullable(operations.get(operator)); }
    private static ValidationException validation(String field, String key, String message) { return new ValidationException(List.of(new FieldViolation(field, key, message))); }
}
