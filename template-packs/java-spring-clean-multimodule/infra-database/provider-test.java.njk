@DataJpaTest
@Import({{ providerType }}.class)
@Sql("{{ className }}.sql")
class {{ className }} {
{% for field in seededFields %}    private static final {{ field.type }} {{ field.constantName }} = {{ field.javaExpression }};
{% endfor %}{% for field in createdFields %}    private static final {{ field.type }} {{ field.constantName }} = {{ field.javaExpression }};
