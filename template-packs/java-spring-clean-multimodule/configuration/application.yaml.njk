spring:
  application:
    name: {{ applicationName }}

server:
  port: ${SERVER_PORT:8080}

application:
  cors:
    allowed-origins: []
    allowed-methods:
      - GET
      - POST
      - PUT
      - DELETE
      - PATCH
      - OPTIONS
    allowed-headers:
      - "*"
    exposed-headers: []
    allow-credentials: false
    max-age: 3600
