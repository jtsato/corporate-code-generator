spring:
  application:
    name: {{ applicationName }}

server:
  port: ${SERVER_PORT:8080}

springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: false

application:
  cors:
    allowed-origins: []
    allowed-methods:
      - GET
      - POST
      - PUT
      - DELETE
      - PATCH
      - OPTIONS
    allowed-headers:
      - "*"
    exposed-headers: []
    allow-credentials: false
    max-age: 3600
