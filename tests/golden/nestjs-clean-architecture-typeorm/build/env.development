# Developer defaults. Committed, so it must never hold a secret.
# Create a `.env` for anything machine-specific; it overrides this file.
NODE_ENV=development
PORT=3000

# Permissive by intent: a developer front end runs on an arbitrary local port.
# Credentials stay off, so the wildcard origin is legal here.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Accept,Accept-Language
CORS_EXPOSED_HEADERS=Location
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600

# Matches the PostgreSQL service in `docker-compose.yml`. Committed credentials
# are acceptable only because they reach nothing but a local container.
DATABASE_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=wallet-service
DATABASE_PASSWORD=wallet-service
DATABASE_NAME=wallet-service

# The project generates no migrations, so development relies on TypeORM building
# the schema from the entities.
DATABASE_SYNCHRONIZE=true
