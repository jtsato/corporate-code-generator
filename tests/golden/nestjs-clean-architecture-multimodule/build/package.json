{
  "name": "wallet-service",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build packages/bootstrap",
    "clean": "tsc --build --clean packages/bootstrap",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./packages/bootstrap/test/jest-e2e.json --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "start:prod": "node packages/bootstrap/dist/main"
  },
  "dependencies": {
    "@wallet-service/bootstrap": "0.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "@types/jest": "^29.5.14",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "roots": ["<rootDir>/packages"],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.spec.json" }]
    },
    "moduleNameMapper": {
      "^@wallet-service/([^/]+)/(.*)$": "<rootDir>/packages/$1/src/$2"
    },
    "collectCoverageFrom": ["packages/*/src/**/*.(t|j)s"],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
