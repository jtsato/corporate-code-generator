# Production defaults. Committed, so it must never hold a secret: every value
# here is either safe in the open or deliberately empty for the deployment to
# supply through real environment variables.
#
# CORS is empty rather than permissive. An unconfigured production deployment
# therefore rejects cross-origin browser calls instead of accepting all of them,
# which is the safer of the two failure modes.
NODE_ENV=production
PORT=3000
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Accept,Accept-Language
CORS_EXPOSED_HEADERS=Location
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600
